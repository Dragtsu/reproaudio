<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.player.reproaudio.controller.CreaAudioController">
   <children>
      <VBox spacing="5.0">
         <children>
            <Label text="Ingrese el texto:" />
            <TextArea fx:id="txtTexto" maxHeight="200.0" maxWidth="500.0" />
            <HBox spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button mnemonicParsing="false">
                     <graphic>
                        <FontIcon iconLiteral="mdi2m-motion-play" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false">
                     <graphic>
                        <FontIcon iconLiteral="mdi2s-skip-forward" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false">
                     <graphic>
                        <FontIcon iconLiteral="mdi2s-skip-backward" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false">
                     <graphic>
                        <FontIcon iconLiteral="mdi2s-skip-next-circle" />
                     </graphic>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </HBox>
            <HBox alignment="BOTTOM_LEFT" spacing="5.0">
               <children>
                  <Button fx:id="btnGenerar" mnemonicParsing="false" onAction="#generarAudio" styleClass="accent" text="Generar">
                     <graphic>
                        <FontIcon iconLiteral="mdi2h-hammer" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" styleClass="accent" text="Limpiar">
                     <graphic>
                        <FontIcon iconLiteral="mdal-cleaning_services" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" styleClass="accent" text="Guardar">
                     <graphic>
                        <FontIcon iconLiteral="mdmz-save" />
                     </graphic>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>

   </children>
</HBox>
